{
  "name": "inerate-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:forge": "node -e \"process.env.ASTRO_SITE='https://forge.inerate.com'; process.env.ASTRO_BASE='/atelier/docs'; require('child_process').spawnSync('npx', ['astro', 'build'], {stdio: 'inherit', shell: true})\"",
    "build:gh": "node -e \"process.env.ASTRO_SITE='https://inerate.github.io'; process.env.ASTRO_BASE='/atelier/docs'; require('child_process').spawnSync('npx', ['astro', 'build'], {stdio: 'inherit', shell: true})\"",
    "sync": "node sync.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.0.0"
  }
}
